# LLM Provider: "ollama" (free local), "openai", or "fallback" (offline templates)
LLM_PROVIDER=ollama

# Ollama Configuration (Local, free, private)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenAI API key (optional, for GPT-4 tutoring responses)
OPENAI_API_KEY=your-key-here
# OPENAI_MODEL=gpt-4o

# Random seed for reproducibility
RANDOM_SEED=42

